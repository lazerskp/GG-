# ==============================================================================
# GULLYGANG Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local, .env, or any real secrets to Git.
#
# IMPORTANT SECURITY NOTICE:
# - Variables prefixed with NEXT_PUBLIC_ are bundled into browser client code.
# - ALL OTHER variables are strictly SERVER-ONLY.
# - Never add NEXT_PUBLIC_ to database keys, admin tokens, or service credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Safe for Browser Exposure)
# ------------------------------------------------------------------------------
# Base URL of the public web application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional InsForge Public Base URL & Anon Key (for public client reads if configured)
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=anon_placeholder_key_for_public_client

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY VARIABLES (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# InsForge Cloud Database URL & Admin Service Key
INSFORGE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=ik_your_server_admin_service_key_here

# Internal Python Music Metadata Service (ytmusicapi backend)
MUSIC_SERVICE_URL=http://localhost:8001
MUSIC_SERVICE_API_KEY=your_internal_shared_service_key_here

# ------------------------------------------------------------------------------
# 3. DEVELOPMENT FIXTURE TOGGLE
# ------------------------------------------------------------------------------
# In production, this must remain 'false'. Set to 'true' ONLY for offline local testing
# without network access or when the database has not yet been seeded.
# When 'false', the application will never silently return fake mock music data.
USE_DEV_FIXTURES=false

# ------------------------------------------------------------------------------
# 4. CACHING & SECURITY CONTROLS
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
